# Browser Firebase Auth (/login). Copy the web app values from Firebase Console → Project settings → General.
# Restart `next dev` after editing — NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional if you use the default host: {PROJECT_ID}.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional; only needed if you add Firebase Analytics (`getAnalytics`)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server): service account + bucket. Must match the same GCP project as browser Auth if you verify ID tokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Only if you created a named Firestore database (not the default). Leave unset for (default).
FIREBASE_FIRESTORE_DATABASE_ID=

# Required in production (minimum 32 characters). Used to sign session JWTs.
KASTROS_SESSION_SECRET=

# Local testing only — enables bundled *.kastros.demo accounts on /login (never use on production Vercel).
KASTROS_DEMO_USERS=false
KASTROS_SHOW_DEMO_CREDS=false

# First admin: create via `npm run bootstrap:fresh` (see docs/FIREBASE_AUTH.md), not env vars.

# --- Vercel (https://vercel.com) ---
# Add every variable above under Project → Settings → Environment Variables (Production + Preview as needed).
# NEXT_PUBLIC_* must be set before build; server-only secrets need not be exposed to the browser.
#
# Firebase Console → Authentication → Settings → Authorized domains: add
#   - your-preview-url.vercel.app
#   - your production custom domain (if any)
#
# Firestore: create database if missing; first deploy seeds collection kastros-hr / document store.
# Storage: enable default bucket; uploads use path uploads/{uuid} (same as local Firebase bucket env).
#
# FIREBASE_PRIVATE_KEY on Vercel: paste as one line with \n where line breaks were (same format as .env.local);
# do not wrap in quotes unless your host requires it.
#
# KASTROS_SESSION_SECRET: required for production (32+ chars). Without Firestore + Admin env, the app falls back
# to ephemeral disk (not suitable on serverless — configure Firebase for real deployments).
#
# Large file uploads: Vercel request bodies are limited (~4.5MB on Hobby). This repo caps server actions on Vercel
# accordingly; use Vercel Pro or larger limits if you need bigger training decks without direct client uploads.
