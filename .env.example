# Browser Firebase Auth (/login). Copy the web app values from Firebase Console → Project settings → General.
# Restart `next dev` after editing — NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional if you use the default host: {PROJECT_ID}.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional; only needed if you add Firebase Analytics (`getAnalytics`)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server): service account + bucket. Must match the same GCP project as browser Auth if you verify ID tokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Only if you created a named Firestore database (not the default). Leave unset for (default).
FIREBASE_FIRESTORE_DATABASE_ID=

# Required in production (minimum 32 characters). Used to sign session JWTs.
KASTROS_SESSION_SECRET=

# Optional: single bootstrap user (disables bundled demo accounts unless KASTROS_DEMO_USERS=true).
KASTROS_HR_EMAIL=
KASTROS_HR_PASSWORD=
# One of: employee | hr_admin | ceo
KASTROS_HR_ROLE=hr_admin
KASTROS_HR_NAME=Configured user

# Allow bundled demo accounts even when KASTROS_HR_* is set, and/or show the credential table on /login in production.
KASTROS_DEMO_USERS=false
KASTROS_SHOW_DEMO_CREDS=false
